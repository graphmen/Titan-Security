{
  "name": "titan-protection-desktop",
  "version": "1.0.2",
  "description": "Titan Protection Command Centre — Windows desktop client",
  "main": "electron/main.js",
  "author": "Titan Protection",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:local": "set TITAN_APP_URL=http://localhost:3010&& electron .",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-desktop-icons.ps1",
    "prebuild": "npm run icons",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "org.titanprotection.commandcentre",
    "productName": "Titan Protection",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "executableName": "TitanProtection",
      "publisherName": "Titan Protection",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Titan Protection",
      "menuCategory": "Titan Protection",
      "runAfterFinish": true,
      "license": "assets/LICENSE.txt",
      "installerLanguages": ["en_US"],
      "displayLanguageSelector": false,
      "artifactName": "TitanProtection-${version}-Setup.exe",
      "uninstallDisplayName": "Titan Protection Command Centre",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
